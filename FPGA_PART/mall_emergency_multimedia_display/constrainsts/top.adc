# Official HX4S20C SW[0] / SW1: ON pulls low.
set_pin_assignment { sw1_n } { LOCATION = C8; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# Official 13_music/a.adc: speaker/buzzer H11; PNP9012 driver, idle high.
set_pin_assignment { buzzer_n } { LOCATION = H11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# SW2/SW3 are UP=raw high, logical zero. SW4 reserved for future video.
set_pin_assignment { sw2_n } { LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { sw3_n } { LOCATION = C6; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

set_pin_assignment {sw4_n} { LOCATION = C5; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
